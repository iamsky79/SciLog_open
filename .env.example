# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# Vercel에 배포할 때는 프로젝트 Settings > Environment Variables에 같은 이름으로 넣으세요.

# ── 필수: Supabase (대시보드 > Project Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role 키는 서버에서만 쓰입니다. 절대 공개하거나 NEXT_PUBLIC_ 이름으로 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 선택: 교사용 AI 학생 분석 기능 (비워두면 해당 기능만 꺼집니다) ──
ANTHROPIC_API_KEY=

# ── 선택: AI 분석 프롬프트에 들어갈 학교 유형 (기본값: 고등학교) ──
SCHOOL_LABEL=과학고
